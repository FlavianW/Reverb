# Copier ce fichier en ".env" (jamais commité) et renseigner des valeurs réelles.

# URL de l'API, exposée au navigateur (fetch côté client).
PUBLIC_API_URL=http://localhost:3000

# URL de l'API, côté serveur SvelteKit uniquement (SSR). Même valeur qu'au-dessus
# en local ; peut différer en production (réseau interne vs domaine public).
API_URL=http://localhost:3000
