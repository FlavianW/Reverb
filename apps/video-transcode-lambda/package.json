{
  "name": "video-transcode-lambda",
  "private": true,
  "version": "0.0.1",
  "description": "Lambda de transcodage vidéo (S3 -> FFmpeg -> S3), déclenché par upload (US-5.1, US-8.2).",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/handler.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "download-ffmpeg": "node scripts/download-ffmpeg.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.925.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.155",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
