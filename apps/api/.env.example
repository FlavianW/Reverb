# Copier ce fichier en ".env" (jamais commité). Les valeurs par défaut
# ci-dessous permettent de démarrer l'application telle quelle en local
# (docker-compose pour Postgres et MinIO) : seules la connexion Google,
# l'import Setlist.fm et les photos d'artiste Last.fm nécessitent de
# vraies clés (voir les commentaires de chaque variable).

PORT=3000

# Origines autorisées en CORS, séparées par des virgules (ex: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Correspond au service "postgres" de docker-compose.yml (port hôte 5433)
DATABASE_URL="postgresql://reverb:reverb@localhost:5433/reverb?schema=public"

# OAuth Google (Google Cloud Console > Identifiants > ID client OAuth 2.0).
# Les valeurs factices ci-dessous permettent à l'API de démarrer sans compte
# Google Cloud (la stratégie OAuth exige des valeurs non vides dès le boot) :
# tout fonctionne sauf le bouton "Continuer avec Google", qui échouera tant
# que de vraies valeurs ne sont pas renseignées.
GOOGLE_CLIENT_ID=factice-remplacer-pour-tester-oauth
GOOGLE_CLIENT_SECRET=factice-remplacer-pour-tester-oauth
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Domaine parent du cookie de session, uniquement quand web et API sont sur
# des sous-domaines distincts (prod : .reverb-social.com). Laisser vide en
# local : web et API partagent l'hôte localhost.
COOKIE_DOMAIN=

# Secret de signature des JWT de session. La valeur par défaut convient en
# local ; en production, une valeur aléatoire longue est servie par SSM.
JWT_SECRET=secret-de-dev-local-uniquement-jamais-en-production
# Durée de vie du token en secondes (3600 = 1h)
JWT_EXPIRES_IN=3600

# Clé API gratuite : https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# Photo de l'artiste favori (US-4.1) et de la page concert. Clé API gratuite :
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Géocodage des villes (US-9.1) via Nominatim (OpenStreetMap) : gratuit, sans
# clé, mais sa politique d'usage impose d'identifier l'application appelante.
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_USER_AGENT=Reverb/1.0 (+https://github.com/FlavianW/Reverb)

# Stockage média (US-5.1). Deux options, même code (S3Service est agnostique) :
#
# 1. MinIO en local (par défaut ci-dessous) : émulation de l'API S3 sans compte AWS,
#    via le service "minio" de docker-compose.yml.
#
# 2. Vrai bucket AWS S3 : laisser S3_ENDPOINT vide (le SDK utilise l'endpoint AWS
#    par défaut selon la région), utiliser les clés d'un utilisateur IAM dédié dont
#    la policy est limitée à ce bucket (voir "Médias (S3)" dans le README).
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=reverb-media
S3_ACCESS_KEY_ID=reverb
S3_SECRET_ACCESS_KEY=reverb-minio
# URL publique de base pour construire les liens des photos.
# MinIO local : http://localhost:9000/<bucket>
# AWS S3 réel : https://<bucket>.s3.<region>.amazonaws.com (ou domaine CloudFront en prod)
S3_PUBLIC_BASE_URL=http://localhost:9000/reverb-media

# Secret partagé avec le Lambda de transcodage vidéo (US-8.2) : authentifie
# ses appels aux endpoints internes /internal/videos/complete|fail.
# La valeur par défaut convient en local (le Lambda ne tourne pas en local :
# les vidéos y restent en "traitement en cours", comportement attendu) ;
# en production, valeur aléatoire longue stockée en SSM Parameter Store.
VIDEO_WEBHOOK_SECRET=secret-webhook-de-dev-local-uniquement
