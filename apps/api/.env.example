# Copier ce fichier en ".env" (jamais commité) et renseigner des valeurs réelles.

PORT=3000

# Origines autorisées en CORS, séparées par des virgules (ex: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Correspond au service "postgres" de docker-compose.yml (port hôte 5433)
DATABASE_URL="postgresql://reverb:reverb@localhost:5433/reverb?schema=public"

# OAuth Google (Google Cloud Console > Identifiants > ID client OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secret de signature des JWT de session (générer une valeur aléatoire longue en local)
JWT_SECRET=
# Durée de vie du token en secondes (3600 = 1h)
JWT_EXPIRES_IN=3600

# Clé API gratuite : https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# Stockage média (US-5.1). En local : MinIO (service "minio" de docker-compose.yml),
# une émulation de l'API S3 sans compte AWS. En prod : vrai bucket S3 + CloudFront.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=reverb-media
S3_ACCESS_KEY_ID=reverb
S3_SECRET_ACCESS_KEY=reverb-minio
# URL publique de base pour construire les liens des photos (bucket ou domaine CloudFront en prod)
S3_PUBLIC_BASE_URL=http://localhost:9000/reverb-media
