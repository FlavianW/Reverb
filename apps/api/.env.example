# Copier ce fichier en ".env" (jamais commité) et renseigner des valeurs réelles.

PORT=3000

# Origines autorisées en CORS, séparées par des virgules (ex: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Correspond au service "postgres" de docker-compose.yml (port hôte 5433)
DATABASE_URL="postgresql://reverb:reverb@localhost:5433/reverb?schema=public"

# OAuth Google (Google Cloud Console > Identifiants > ID client OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secret de signature des JWT de session (générer une valeur aléatoire longue en local)
JWT_SECRET=
# Durée de vie du token en secondes (3600 = 1h)
JWT_EXPIRES_IN=3600
