generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte utilisateur, créé soit via OAuth Google (US-1.1), soit via
/// inscription email/mot de passe classique. `googleId` et `passwordHash`
/// sont mutuellement facultatifs : chaque compte a l'un des deux (jamais aucun).
model User {
  id           String              @id @default(uuid())
  email        String              @unique
  googleId     String?             @unique
  passwordHash String?
  pseudo       String              @unique
  avatarUrl    String?
  bio          String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  concerts     Concert[]
  attendances  ConcertAttendance[]
  ratings      ConcertRating[]
  comments     Comment[]
  photos       Photo[]
  reports      Report[]

  @@map("users")
}

/// Fiche concert (artiste, lieu, date). La setlist n'est pas stockée ici :
/// elle est récupérée en direct depuis Setlist.fm quand le concert est passé (US-2.1).
model Concert {
  id          String              @id @default(uuid())
  artistName  String
  venueName   String
  city        String
  date        DateTime
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attendances ConcertAttendance[]
  ratings     ConcertRating[]
  comments    Comment[]
  photos      Photo[]

  @@map("concerts")
}

/// Marque « J'y étais » d'un utilisateur sur un concert (US-2.2).
model ConcertAttendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertId String
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, concertId])
  @@map("concert_attendances")
}

/// Note (1 à 5) d'un utilisateur sur un concert, modifiable (US-2.3).
model ConcertRating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertId String
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, concertId])
  @@map("concert_ratings")
}

/// Commentaire sur un concert, supprimable uniquement par son auteur (US-2.4).
model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertId String
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  reports   Report[]

  @@map("comments")
}

/// Photo uploadée sur une page concert (US-5.1). `key` est le chemin S3, utile
/// pour une suppression future ; `url` est le lien public déjà résolu.
model Photo {
  id           String   @id @default(uuid())
  key          String
  url          String
  concertId    String
  concert      Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  reports      Report[]

  @@map("photos")
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  OTHER
}

/// Signalement d'un commentaire ou d'une photo (US-6.1). Le traitement par un
/// modérateur est hors périmètre MVP : seul l'enregistrement est couvert.
model Report {
  id         String       @id @default(uuid())
  reason     ReportReason
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  photoId    String?
  photo      Photo?       @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([reporterId, commentId])
  @@unique([reporterId, photoId])
  @@map("reports")
}
