generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte utilisateur, créé soit via OAuth Google (US-1.1), soit via
/// inscription email/mot de passe classique. `googleId` et `passwordHash`
/// sont mutuellement facultatifs : chaque compte a l'un des deux (jamais aucun).
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  googleId     String?   @unique
  passwordHash String?
  pseudo       String    @unique
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  concerts     Concert[]

  @@map("users")
}

/// Fiche concert (artiste, lieu, date). La setlist n'est pas stockée ici :
/// elle est récupérée en direct depuis Setlist.fm quand le concert est passé (US-2.1).
model Concert {
  id          String   @id @default(uuid())
  artistName  String
  venueName   String
  city        String
  date        DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("concerts")
}
