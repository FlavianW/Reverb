generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte utilisateur, créé soit via OAuth Google (US-1.1), soit via
/// inscription email/mot de passe classique. `googleId` et `passwordHash`
/// sont mutuellement facultatifs : chaque compte a l'un des deux (jamais aucun).
model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  googleId               String?             @unique
  passwordHash           String?
  pseudo                 String              @unique
  avatarUrl              String?
  bannerUrl              String?
  bio                    String?
  favoriteArtist         String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  concerts               Concert[]
  attendances            ConcertAttendance[]
  ratings                ConcertRating[]
  comments               Comment[]
  photos                 Photo[]
  videos                 Video[]
  reports                Report[]
  sentFriendRequests     Friendship[]        @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]        @relation("FriendshipAddressee")
  posts                  Post[]
  likes                  Like[]
  conversationsAsUserA   Conversation[]      @relation("ConversationUserA")
  conversationsAsUserB   Conversation[]      @relation("ConversationUserB")
  messages               Message[]

  @@map("users")
}

/// Fiche concert (artiste, lieu, date). La setlist n'est pas stockée ici :
/// elle est récupérée en direct depuis Setlist.fm quand le concert est passé (US-2.1).
/// `latitude`/`longitude` (précision ville, US-9.1) sont nullables : soit issues
/// de Setlist.fm à l'import, soit d'un géocodage par ville à la création manuelle,
/// soit absentes si les deux échouent — le concert reste valide sans coordonnées.
model Concert {
  id          String              @id @default(uuid())
  artistName  String
  venueName   String
  city        String
  date        DateTime
  latitude    Float?
  longitude   Float?
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attendances ConcertAttendance[]
  ratings     ConcertRating[]
  comments    Comment[]
  photos      Photo[]
  videos      Video[]
  posts       Post[]

  @@map("concerts")
}

/// Marque « J'y étais » d'un utilisateur sur un concert (US-2.2).
model ConcertAttendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertId String
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, concertId])
  @@map("concert_attendances")
}

/// Note (1 à 5) d'un utilisateur sur un concert, modifiable (US-2.3).
model ConcertRating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertId String
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, concertId])
  @@map("concert_ratings")
}

/// Commentaire sur un concert, supprimable uniquement par son auteur (US-2.4).
model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concertId String
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  reports   Report[]

  @@map("comments")
}

/// Photo uploadée sur une page concert (US-5.1). `key` est le chemin S3, utile
/// pour une suppression future ; `url` est le lien public déjà résolu.
model Photo {
  id           String   @id @default(uuid())
  key          String
  url          String
  concertId    String
  concert      Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  reports      Report[]

  @@map("photos")
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

/// Vidéo uploadée sur une page concert ou attachée à un post explicite —
/// une seule table pour les deux contextes (`concertId`/`postId` mutuellement
/// exclusifs, imposé côté service). Contrairement aux photos, la vidéo a un
/// cycle de vie asynchrone commun (upload direct S3 puis transcodage Lambda) :
/// dupliquer ce lifecycle entre deux tables serait redondant, d'où la table
/// unique plutôt que de suivre le pattern `Photo`/`PostPhoto`.
model Video {
  id              String      @id @default(uuid())
  /// Clé S3 de l'original uploadé — unique car c'est la seule information
  /// que le Lambda de transcodage connaît de la vidéo (il reçoit un
  /// événement S3, pas un id de ligne) : le webhook interne retrouve la
  /// ligne par cette clé plutôt que par `id`.
  key             String      @unique
  playbackKey     String?
  playbackUrl     String?
  posterKey       String?
  posterUrl       String?
  durationSeconds Int?
  status          VideoStatus @default(PROCESSING)
  concertId       String?
  concert         Concert?    @relation(fields: [concertId], references: [id], onDelete: Cascade)
  postId          String?     @unique
  post            Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User        @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime    @default(now())
  reports         Report[]

  @@map("videos")
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  OTHER
}

/// Signalement d'un commentaire, d'une photo ou d'une vidéo (US-6.1). Le
/// traitement par un modérateur est hors périmètre MVP : seul
/// l'enregistrement est couvert.
model Report {
  id         String       @id @default(uuid())
  reason     ReportReason
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  photoId    String?
  photo      Photo?       @relation(fields: [photoId], references: [id], onDelete: Cascade)
  videoId    String?
  video      Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([reporterId, commentId])
  @@unique([reporterId, photoId])
  @@unique([reporterId, videoId])
  @@map("reports")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Relation d'amitié à validation mutuelle (US-7.1) : une seule ligne par paire
/// ordonnée (requester, addressee). Si une demande inverse PENDING existe déjà,
/// le service l'accepte au lieu de créer un doublon symétrique.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

enum PostType {
  RATING
  ATTENDANCE
  PHOTO
}

/// Élément du fil d'actualité (US-8.x), généré automatiquement à la première
/// notation (RATING) et à la première attendance (ATTENDANCE) d'un concert,
/// ou créé explicitement (PHOTO, photos + texte). `concertId` est toujours
/// renseigné pour RATING/ATTENDANCE et facultatif pour PHOTO. `ratingValue`
/// est dénormalisé au moment de la création : le post reste immuable même si
/// la note est modifiée ensuite.
model Post {
  id          String      @id @default(uuid())
  type        PostType
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  concertId   String?
  concert     Concert?    @relation(fields: [concertId], references: [id], onDelete: Cascade)
  content     String?
  ratingValue Int?
  createdAt   DateTime    @default(now())
  photos      PostPhoto[]
  video       Video?
  likes       Like[]

  @@index([createdAt, id])
  @@map("posts")
}

/// Photo attachée à un post explicite (US-8.2), même convention que `Photo`
/// (clé S3 + URL résolue) mais rattachée à un post plutôt qu'à un concert.
model PostPhoto {
  id        String   @id @default(uuid())
  key       String
  url       String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("post_photos")
}

/// « J'aime » d'un utilisateur sur un post (US-8.3), une fois par personne.
model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("likes")
}

/// Conversation privée 1-à-1 entre deux amis (US-10.x). Paire canonique
/// (plus petit id en A) pour que @@unique garantisse une seule ligne par
/// paire sans clause OR. lastReadAtUserA/B porte le suivi de lecture par
/// participant (US-10.3) — une table à part serait une complexité inutile
/// pour seulement deux participants possibles.
model Conversation {
  id              String    @id @default(uuid())
  userAId         String
  userA           User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId         String
  userB           User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime?
  lastReadAtUserA DateTime?
  lastReadAtUserB DateTime?
  createdAt       DateTime  @default(now())
  messages        Message[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

/// Message texte échangé dans une conversation (US-10.1). Diffusé en temps
/// réel via Socket.IO puis persisté ; pas de pièce jointe en v1.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt, id])
  @@map("messages")
}
