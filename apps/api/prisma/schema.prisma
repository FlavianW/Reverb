generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte utilisateur. Créé automatiquement à la première connexion OAuth (US-1.1) :
/// aucun mot de passe local, l'authentification est entièrement déléguée à Google.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  googleId  String   @unique
  pseudo    String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
